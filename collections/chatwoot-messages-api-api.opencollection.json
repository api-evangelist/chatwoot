            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.chatwoot.com/public/api/v1/inboxes/:inbox_identifier/contacts/:contact_identifier/conversations/:conversation_id/messages",
            "params": [
              {
                "name": "inbox_identifier",
                "value": "",
                "type": "path",
                "description": "The identifier obtained from API inbox channel"
              },
              {
                "name": "contact_identifier",
                "value": "",
                "type": "path",
                "description": "The source id of contact obtained on contact create"
              },
              {
                "name": "conversation_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the conversation"
              }
            ]
          },
          "docs": "List all messages in the conversation"
        },
        {
          "info": {
            "name": "Create a message",
            "type": "http"
          },
          "http": {
