              {
                "name": "inbox_identifier",
                "value": "",
                "type": "path",
                "description": "The identifier obtained from API inbox channel"
              },
              {
                "name": "contact_identifier",
                "value": "",
                "type": "path",
                "description": "The source id of contact obtained on contact create"
              },
              {
                "name": "conversation_id",
                "value": "",
