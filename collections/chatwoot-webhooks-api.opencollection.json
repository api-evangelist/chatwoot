{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chatwoot Account AgentBots Webhooks API",
    "version": "1.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/webhooks",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "List all webhooks in the account"
        },
        {
          "info": {
            "name": "Add a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/webhooks",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Add a webhook subscription to the account"
        },
        {
          "info": {
            "name": "Update a webhook object",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the webhook"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Update a webhook object in the account"
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/webhooks/:webhook_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the webhook"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Delete a webhook from the account"
        }
      ]
    }
  ],
  "bundled": true
}