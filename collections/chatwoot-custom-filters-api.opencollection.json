            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Get the details of a custom filter in the account"
        },
        {
          "info": {
            "name": "Update a custom filter",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/custom_filters/:custom_filter_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "custom_filter_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the custom filter"
