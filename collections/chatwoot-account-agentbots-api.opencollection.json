{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chatwoot Account AgentBots API",
    "version": "1.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Account AgentBots",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all AgentBots",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/agent_bots",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "List all agent bots available for the current account"
        },
        {
          "info": {
            "name": "Create an Agent Bot",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/agent_bots",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Create an agent bot in the account"
        },
        {
          "info": {
            "name": "Get an agent bot details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/agent_bots/:id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the agentbot to be updated"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Get the details of an agent bot in the account"
        },
        {
          "info": {
            "name": "Update an agent bot",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/agent_bots/:id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the agentbot to be updated"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Update an agent bot's attributes"
        },
        {
          "info": {
            "name": "Delete an AgentBot",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/agent_bots/:id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the agentbot to be updated"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Delete an AgentBot from the account"
        }
      ]
    }
  ],
  "bundled": true
}