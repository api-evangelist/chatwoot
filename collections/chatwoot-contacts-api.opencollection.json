{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chatwoot Account AgentBots Contacts API",
    "version": "1.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.chatwoot.com/api/v1/accounts/:account_id/contacts",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the account"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "The attribute by which list should be sorted"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page parameter"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
          },
          "docs": "Listing all the resolved contacts with pagination (Page size = 15). Resolved contacts are the ones with a value for identifier, email or phone number"
        },
