{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chatwoot Agents Platform Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_access_token",
      "value": "{{api_access_token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
