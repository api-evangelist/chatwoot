            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.chatwoot.com/platform/api/v1/users/:id/login",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "api_access_token",
              "value": "{{api_access_token}}",
              "placement": "header"
            }
